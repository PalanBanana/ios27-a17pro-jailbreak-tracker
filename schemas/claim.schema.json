{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "description": "One technical claim tracked by the project. Verdicts follow docs/RESEARCH_METHODOLOGY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "description", "verdict", "confidence",
    "device_scope", "chipset_scope", "ios_scope", "build_scope",
    "supporting_source_ids", "contradicting_source_ids",
    "limitations", "first_observed", "last_checked"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^C-\\d{3}$"},
    "title": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 20},
    "verdict": {"type": "string", "enum": ["verified", "partially_verified", "unverified", "disproved", "superseded"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "device_scope": {"type": "string", "minLength": 1},
    "chipset_scope": {"type": "string", "minLength": 1},
    "ios_scope": {"type": "string", "minLength": 1},
    "build_scope": {"type": "string", "minLength": 1},
    "supporting_source_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^S-\\d{3}$"}
    },
    "contradicting_source_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^S-\\d{3}$"}
    },
    "limitations": {"type": "string", "minLength": 10},
    "first_observed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "last_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {"type": "string"}
  }
}
