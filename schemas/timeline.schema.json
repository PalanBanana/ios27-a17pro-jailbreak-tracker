{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline event",
  "description": "A dated event in the research timeline. Dates may be YYYY-MM when only the month is known.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_date", "publication_date", "event_category",
    "description", "associated_source_ids", "device_scope", "firmware_scope",
    "verification_state"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^E-\\d{3}$"},
    "event_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
    "publication_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
    "event_category": {
      "type": "string",
      "enum": [
        "vendor_announcement", "apple_security_release", "firmware_release",
        "public_disclosure", "conference_demo", "tool_release", "signing_change",
        "press_coverage", "research_lead", "tracker_update", "scam_warning"
      ]
    },
    "description": {"type": "string", "minLength": 20},
    "associated_source_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^S-\\d{3}$"}
    },
    "device_scope": {"type": "string", "minLength": 1},
    "firmware_scope": {"type": "string", "minLength": 1},
    "verification_state": {
      "type": "string",
      "enum": ["verified", "partially_verified", "unverified", "disputed", "superseded"]
    }
  }
}
